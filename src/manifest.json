{
	"manifest_version": 3,
	"name": "PixivMaster",
	"description": "pixiv のユーザーページに X 風の画像ビュワーを追加します",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"content_scripts": [
		{
			"matches": ["https://www.pixiv.net/*"],
			"js": ["inject.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://www.pixiv.net/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "PixivMaster",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"permissions": ["storage"]
}
