{
	"manifest_version": 3,
	"name": "XViewer for Pixiv",
	"description": "pixiv のユーザーページに X 風の画像ビュワーを追加します。pixiv プラットフォームを利用して開発した非公式の拡張機能であり、ピクシブ株式会社が作成・配布するものではありません。",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"content_scripts": [
		{
			"matches": ["https://www.pixiv.net/*"],
			"js": ["inject.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://www.pixiv.net/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup/popup.html"
	},
	"permissions": ["storage"]
}
